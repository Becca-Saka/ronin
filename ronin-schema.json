    },
    "secrets": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "string"
        }
      ],
      "title": "Secrets"
    },
    "workflows": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/WorkflowSpec"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Named workflows. Each owns an app and its tests.",
      "title": "Workflows"
    },
    "journeys": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/JourneySpec"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Journeys"
    },
    "journey": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Journey"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "security_rules": {
      "items": {
        "type": "string"
      },
      "title": "Security Rules",
