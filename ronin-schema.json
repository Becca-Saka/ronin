{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Becca-Saka/ronin/master/ronin-schema.json",
  "$defs": {
    "Category": {
      "description": "What a scenario looks for.",
      "enum": [
        "functional",
        "input",
        "security",
        "accessibility",
        "performance",
        "network",
        "lifecycle",
        "permission"
      ],
      "title": "Category",
      "type": "string"
    },
    "CoverageSpec": {
      "additionalProperties": false,
      "description": "One category, and which shapes of test to write for it.\n\nEight categories and nine types give up to seventy-two pairs. One model\ncall per pair is only affordable where a file says which pairs matter. A\npair nothing declares is never generated, and the report names it as\nuncovered.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category",
          "description": "What these scenarios look for."
        },
        "types": {
          "description": "Which shapes of test to write for this category.",
          "items": {
            "$ref": "#/$defs/ScenarioType"
          },
          "minItems": 1,
          "title": "Types",
          "type": "array"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "P1",
          "description": "Which cells a run has to finish first, if it cannot finish all."
        }
      },
      "required": [
        "category",
        "types"
      ],
      "title": "CoverageSpec",
      "type": "object"
    },
    "DeclaredValue": {
      "additionalProperties": false,
      "description": "A declared value, whether it is sensitive, and what the app owes it.\n\nA value marked secret is replaced by its name in everything Ronin writes\ndown. Nothing else is masked, so a credential written straight into the\njourney text is not hidden.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        },
        "refused": {
          "default": false,
          "description": "True where this app refuses the value, which is a fact about the app that no reading of the value could find. A scenario about a refusal names one of these, and the declaration answers for it.",
          "title": "Refused",
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "title": "DeclaredValue",
      "type": "object"
    },
    "DeviceSpec": {
      "additionalProperties": false,
      "description": "The target a run drives.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Emulator, simulator or device name.",
          "title": "Name"
        },
        "platform": {
          "anyOf": [
            {
              "enum": [
                "android",
                "ios"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which platform to run against.",
          "title": "Platform"
        },
        "headless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run the emulator without a window.",
          "title": "Headless"
        }
      },
      "title": "DeviceSpec",
      "type": "object"
    },
    "JourneySpec": {
      "additionalProperties": false,
      "description": "One test: what a user does, and what must be true afterwards.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "journey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The journey, in prose.",
          "title": "Journey"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Another spelling of 'journey'.",
          "title": "Description"
        },
        "security_rules": {
          "description": "Rules every scenario must respect.",
          "items": {
            "type": "string"
          },
          "title": "Security Rules",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/DeclaredValue"
              },
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Values for this test, over the workflow's.",
          "title": "Env",
          "type": "object"
        }
      },
      "title": "JourneySpec",
      "type": "object"
    },
    "Priority": {
      "description": "Which cells a run has to finish first.\n\nA run can die part way: a device drops, a provider refuses, a person\nstops it. The order decides what it got through, so a product says which\ncells matter rather than a table in Ronin.",
      "enum": [
        "P0",
        "P1",
        "P2"
      ],
      "title": "Priority",
      "type": "string"
    },
    "ScenarioType": {
      "description": "What shape a scenario takes.",
      "enum": [
        "happy_path",
        "negative",
        "boundary",
        "empty",
        "concurrency",
        "interruption",
        "recovery",
        "role",
        "exploratory"
      ],
      "title": "ScenarioType",
      "type": "string"
    },
    "WorkflowSpec": {
      "additionalProperties": false,
      "description": "One app, one device, one environment, and the tests to run against them.",
      "properties": {
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceSpec"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The target, as a name or a block.",
          "title": "Device"
        },
        "emulator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Another spelling of 'device'.",
          "title": "Emulator"
        },
        "platform": {
          "anyOf": [
            {
              "enum": [
                "android",
                "ios"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "headless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headless"
        },
        "app": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "App binary, relative to this file.",
          "title": "App"
        },
        "app_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Another spelling of 'app'.",
          "title": "App Path"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "fast_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cheaper model for per-step planning.",
          "title": "Fast Model"
        },
        "grounding": {
          "anyOf": [
            {
              "enum": [
                "coordinates",
                "marks",
                "describe"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the planner names a target.",
          "title": "Grounding"
        },
        "max_steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "settle_time": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settle Time"
        },
        "output_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Dir"
        },
        "record": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Record the screen during the run.",
          "title": "Record"
        },
        "record_session": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Another spelling of 'record'.",
          "title": "Record Session"
        },
        "env": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/DeclaredValue"
              },
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Env",
          "type": "object"
        },
        "secrets": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "description": "Names in 'env' to treat as sensitive.",
          "title": "Secrets"
        },
        "journeys": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/JourneySpec"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journeys"
        },
        "journey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journey"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "security_rules": {
          "items": {
            "type": "string"
          },
          "title": "Security Rules",
          "type": "array"
        },
        "coverage": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CoverageSpec"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage"
        },
        "actors": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/DeclaredValue"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Other accounts a role scenario signs in as, by name. Each holds whatever this app signs in with, under names you choose.",
          "title": "Actors"
        }
      },
      "title": "WorkflowSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A ronin.yaml: settings for every workflow, and the workflows.",
  "properties": {
